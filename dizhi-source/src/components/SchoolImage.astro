---
import { href } from '../lib/site';
interface Props { id: string; alt: string; class?: string; priority?: boolean; sizes?: string; position?: string; mobilePortrait?: boolean; }
const { id, alt, class: className = '', priority = false, sizes = '(min-width: 1440px) 1400px, 100vw', position = '50% 50%', mobilePortrait = false } = Astro.props;
---
<div class:list={['school-image', className]} style={`--focal-point:${position}`}>
  <picture>
  {mobilePortrait && <source media="(max-width: 767px)" type="image/avif" srcset={[480, 800, 1280].map(w => `${href(`media/campus-${id}-portrait-${w}.avif`)} ${w}w`).join(', ')} sizes="100vw" />}
  <source type="image/avif" srcset={[480, 800, 1280, 1920].map(w => `${href(`media/campus-${id}-${w}.avif`)} ${w}w`).join(', ')} sizes={sizes} />
  <img src={href(`media/campus-${id}-1280.webp`)}
    srcset={[480, 800, 1280, 1920].map(w => `${href(`media/campus-${id}-${w}.webp`)} ${w}w`).join(', ')}
    sizes={sizes} width="1920" height="1440" alt={alt}
    loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
  </picture>
  <span class="image-failure" hidden>影像暂时无法加载，图片说明：{alt}</span>
</div>
