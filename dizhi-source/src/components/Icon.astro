---
interface Props { name: string; size?: number; class?: string; }
const { name, size = 20, class: className = '' } = Astro.props;
const icons = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });
const original = icons[`../icons/${name}.svg`];
if (!original) throw new Error(`Unknown Phosphor icon: ${name}`);
const svg = original
  .replace(/<svg[^>]*>/, `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="${size}" height="${size}" fill="currentColor" aria-hidden="true" focusable="false" class="icon ${className}">`);
---
<Fragment set:html={svg} />
