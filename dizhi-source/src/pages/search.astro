---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/site';
---
<BaseLayout title="站内搜索" description="搜索学校介绍、招生信息、新闻报道、科学教育与校园生活，快速找到需要的公开信息。" noindex searchable={false}>
  <PageHeading title="站内搜索" english="FIND WHAT MATTERS" intro="从一个关键词开始，找到你关心的信息。" />
  <section class="search-page container"><form id="search-form" role="search"><label for="search-input">搜索学校、招生与校园资讯</label><div class="search-field"><Icon name="magnifying-glass" size={28} /><input type="search" id="search-input" name="q" autocomplete="off" maxlength="100" placeholder="例如：招生、篮球、李四光" /><button class="action action-button" type="submit">搜索<Icon name="arrow-right" /></button></div><p class="search-helper">支持中文全文检索，搜索内容保留在本地浏览器。</p></form><div class="search-suggestions" aria-label="常用搜索"><span>常用关键词</span>{['招生','校史','篮球','科学','校训'].map(q => <a href={`${href('search.html')}?q=${encodeURIComponent(q)}`} data-query={q}>{q}</a>)}</div><p id="search-status" role="status" aria-live="polite">输入关键词，查找全站内容。</p><div id="search-results" aria-busy="false"></div><button class="action action-outline search-more" id="search-more" hidden>显示更多结果<Icon name="caret-down" /></button><noscript><p>全文搜索需要 JavaScript。你仍可通过<a href={href('admissions.html')}>招生信息</a>、<a href={href('about.html')}>学校概况</a>和<a href={href('news.html')}>新闻动态</a>查阅内容。</p></noscript></section>
  <script>import '../scripts/search';</script>
</BaseLayout>
